NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase project settings -> API). Server-side only —
# never expose to the browser. Required for proposal_versions / audit_log
# writes (Section 13: those tables' INSERT policies are service-role only).
SUPABASE_SERVICE_ROLE_KEY=

# Section 11.1 cost control: generation defaults to mock mode (static
# placeholder text, no API calls). Set to "live" to call the real Claude
# API — requires ANTHROPIC_API_KEY to also be set.
CLAUDE_GENERATION_MODE=mock
ANTHROPIC_API_KEY=
